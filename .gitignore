# Generated documentation source, built from doc_classes/*.xml
/gen/

# protoc/grpc_cpp_plugin output, regenerated by SConstruct from proto/displacement.proto
/src/rpc_gen/

# godot-cpp submodule build artifacts (the source itself stays)
godot-cpp/bin/
godot-cpp/gen/

# vcpkg
vcpkg_installed/

# --- Godot ------------------------------------------------------------------
# Editor cache, regenerated on open.
.godot/

# Godot hot-reload lock files (e.g. ~libprocedural_city.*.dll)
~*

# Cities the generator persists into the demo scene: regenerate, never commit.
/demo/generated_city/

# Local project-setting overrides (used to record at a different resolution).
override.cfg

# The godisplacementx / gpudisplacementx CLIs are not committed - the extension
# downloads the matching release on demand, or picks up a binary dropped here.
/demo/addons/procedural_city/godisplacementx/
/demo/addons/procedural_city/gpudisplacementx/

