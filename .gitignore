# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker/debug files
*.ilk
*.pdb
*.exp

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Godot hot-reload lock files (e.g. ~libprocedural_city.*.dll)
~*

# Build directories
build/
Build/
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json

# SCons cache
.sconsign.dblite
.sconf_temp/

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# godot-cpp submodule build artifacts are ignored, but keep the source
godot-cpp/bin/
godot-cpp/gen/

# Godot editor cache (regenerated automatically, never needs to be committed)
.godot/

# Editor / tool-specific local settings (not part of the project)
.vscode/
.claude/

# OS cruft
.DS_Store
Thumbs.db

# Re-include the bundled goplacementx CLI binaries (override *.exe / *.dll above)
!**/goplacementx/**
!**/goplacementx/**/*.exe
!**/goplacementx/**/*

# Generated PNG/JSON artifacts from the tool
*.png.import
